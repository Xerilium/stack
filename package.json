{
  "name": "stack",
  "version": "0.0.1",
  "description": "Stack 'em up. Burn 'em down. Simple, multi-project task management and prioritization.",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm run build:core && pnpm run build:cli && pnpm run build:api && pnpm run build:bots && pnpm run build:mcp && pnpm run build:web && pnpm run build:host",
    "build:core": "tsc -p tsconfig.core.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:api": "tsc -p tsconfig.api.json",
    "build:bots": "tsc -p tsconfig.bots.json",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "build:host": "tsc -p host/tsconfig.json",
    "openapi": "pnpm run build:api && node dist/api/openapi-write.js",
    "bakeoff": "node dist/core/bakeoff.js",
    "clean": "rm -rf dist",
    "lint": "eslint . && tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.cli.json && tsc --noEmit -p tsconfig.api.json && tsc --noEmit -p tsconfig.bots.json && tsc --noEmit -p tsconfig.mcp.json && pnpm --filter stack-web typecheck && tsc --noEmit -p host/tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "parity": "jest tests/parity/cli-parity.test.ts",
    "build:web": "pnpm --filter stack-web build",
    "test:web": "pnpm --filter stack-web test",
    "test:e2e": "pnpm --filter stack-web e2e",
    "web": "node dist/cli/index.js web"
  },
  "keywords": [
    "task-management",
    "prioritization",
    "stack",
    "xerilium"
  ],
  "author": "Xerilium",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xerilium/stack.git"
  },
  "bugs": {
    "url": "https://github.com/Xerilium/stack/issues"
  },
  "homepage": "https://github.com/Xerilium/stack#readme",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@xerilium/catalyst": "0.3.2",
    "eslint": "9.39.5",
    "jest": "30.2.0",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "stack": "dist/cli/index.js",
    "stack-mcp": "dist/mcp/stdio.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ical.js": "2.2.1",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  }
}
