{
  "name": "stack",
  "version": "0.0.1",
  "description": "Stack 'em up. Burn 'em down. Simple, multi-project task management and prioritization.",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm build:core && pnpm build:cli",
    "build:core": "tsc -p tsconfig.core.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit -p tsconfig.core.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "task-management",
    "prioritization",
    "stack",
    "xerilium"
  ],
  "author": "Xerilium",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xerilium/stack.git"
  },
  "bugs": {
    "url": "https://github.com/Xerilium/stack/issues"
  },
  "homepage": "https://github.com/Xerilium/stack#readme",
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.5",
    "@xerilium/catalyst": "file:.xe/config/catalyst-latest.tgz",
    "jest": "30.2.0",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22"
  }
}
