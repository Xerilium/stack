{
  "traceability": {
    "default": { "code": "warning", "test": "warning" },
    "paths": {
      "code": ["src/", "web/src/", "scripts/", "docs/", "desktop/src/", "desktop/scripts/"],
      "test": ["tests/", "web/tests/", "desktop/tests/", "web/e2e/", "**/*.test.*", "**/*.spec.*"],
      "exclude": ["**/node_modules/**", "**/dist/**", "**/coverage/**", "**/.git/**"]
    }
  }
}
